<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.saintsau.slam2.gnotes30.controller.AddProfController">
   <children>
      <AnchorPane prefHeight="271.0" prefWidth="307.0">
         <children>
            <Label text="Ajouter un Professeur" 
                   style="-fx-font-size: 20px; -fx-text-fill: #333;" 
                   AnchorPane.topAnchor="20.0" 
                   AnchorPane.leftAnchor="20.0" />
            <TextField fx:id="nameField" 
                       promptText="Nom du Professeur" 
                       AnchorPane.topAnchor="70.0" 
                       AnchorPane.leftAnchor="20.0" 
                       AnchorPane.rightAnchor="20.0" />
            <TextField fx:id="passwordField" 
                       promptText="Mot de passe" 
                       AnchorPane.topAnchor="120.0" 
                       AnchorPane.leftAnchor="20.0" 
                       AnchorPane.rightAnchor="20.0" />
            <Button text="Enregistrer" 
                    onAction="#saveProfessor" 
                    style="-fx-background-color: #C0425F; -fx-text-fill: WHITE;" 
                    AnchorPane.topAnchor="180.0" 
                    AnchorPane.leftAnchor="20.0" />
         </children>
      </AnchorPane>
   </children>
</StackPane>
