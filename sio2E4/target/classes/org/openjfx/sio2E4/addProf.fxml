<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.openjfx.sio2E4.controller.AddProfController">
   <children>
      <AnchorPane prefHeight="271.0" prefWidth="307.0">
         <children>
            <Label style="-fx-font-size: 20px; -fx-text-fill: #333;" text="Ajouter un Professeur" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
            <TextField fx:id="nameField" promptText="Nom du Professeur" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="70.0" />
            <TextField fx:id="subjectField" promptText="Matière enseignée" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="120.0" />
            <Button onAction="#saveProfessor" style="-fx-background-color: #C0425F; -fx-text-fill: WHITE;" text="Enregistrer" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="180.0" />
         </children>
      </AnchorPane>
   </children>
</StackPane>
