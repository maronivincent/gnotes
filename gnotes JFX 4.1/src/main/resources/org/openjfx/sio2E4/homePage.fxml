<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.saintsau.slam2.gnotes30.controller.logoutPageController">
   <children>
      <AnchorPane>
         <children>
            <AnchorPane style="-fx-background-color: B53654;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="385.0" AnchorPane.topAnchor="0.0">
               <children>
					<Button fx:id="actiontarget" onAction="#GoToLog" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #C0425F; -fx-font-size: 16px;" text="Se Déconnecter" textFill="WHITE" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
                  <ImageView fitHeight="130.0" fitWidth="130.0" AnchorPane.leftAnchor="42.5" AnchorPane.topAnchor="80.0">
                     <image>
                        <Image url="@profile.png" />
                     </image>
                  </ImageView>
                  <Text fill="WHITE" text="Administrateur" AnchorPane.leftAnchor="65.0" AnchorPane.topAnchor="224.0" />
               </children>
            </AnchorPane>
            <AnchorPane style="-fx-background-color: #EBEBEB;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="215.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <tabs>
                        <Tab text="Professeur">
                           <content>
                              <AnchorPane>

                                 <children>
                                    <TableView fx:id="professorTable" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="85.0">
                                       <columns>
                                          <TableColumn fx:id="columnNomProfessor" text="Nom" />
                                          <TableColumn fx:id="columnActionsProfessor" text="Actions" />
                                       </columns>
                                    </TableView>
										<Button onAction="#goToAddProfessorScreen"  style="-fx-background-color: #C0425F; -fx-text-fill: WHITE;" text="Ajouter un Professeur" />
                                 </children>
                              </AnchorPane>
                           </content>
                        </Tab>
                        <Tab text="Eleves">
                           <content>
                              <AnchorPane>
                                 <children>
                                    <TableView fx:id="studentTable" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="85.0">
                                       <columns>
                                          <TableColumn fx:id="columnNomStudent" text="Nom" />
                                          <TableColumn fx:id="columnPrenomStudent" text="Prenom" />
                                          <TableColumn fx:id="columnActionsStudent" text="Actions" />
                                       </columns>
                                    </TableView>
                                    <Button onAction="#goToAddStudentScreen" style="-fx-background-color: #C0425F; -fx-text-fill: WHITE;" text="Ajouter un Eleve" />
                                 </children>
                              </AnchorPane>
                           </content>
                        </Tab>
                        <Tab text="Contrôles">
                           <content>
                              <AnchorPane>
                                 <children>
                                    <TableView fx:id="controleTable" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="85.0">
                                       <columns>
                                          <TableColumn fx:id="columnMatiereControle" text="Matière" />
                                          <TableColumn fx:id="columnCoefControle" text="Coef" />
                                          <TableColumn fx:id="columnTypeControle" prefWidth= "63.0" text="Type" />
                                          <TableColumn fx:id="columnNoteControle" prefWidth= "66.0" text="Note" />
                                          <TableColumn fx:id="columnNomEtudiantControle" prefWidth= "123.0" text="Nom Etudiant" />
                                          <TableColumn fx:id="columnDateControle" prefWidth= "153.0" text="Date" />
                                          <TableColumn fx:id="columnActionsControle" text="Actions" />
                                       </columns>
                                    </TableView>
                                    <Button onAction="#goToAddControleScreen"  style="-fx-background-color: #C0425F; -fx-text-fill: WHITE;" text="Ajouter un Controle" />
                                 </children>
                              </AnchorPane>
                           </content>
                        </Tab>
                     </tabs>
                  </TabPane>
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
   </children>
</StackPane>
