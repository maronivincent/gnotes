<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" prefHeight="400.0" prefWidth="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.saintsau.slam2.gnotes30.controller.AddControleController">
   <children>
      <AnchorPane prefHeight="400.0" prefWidth="400.0">
         <children>
            <Label style="-fx-font-size: 20px; -fx-text-fill: #333;" text="Ajouter un Controle" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
            <TextField fx:id="intituleField" promptText="matiere" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="70.0" />
            <TextField fx:id="coefField" promptText="coefficient" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="120.0" />
            <TextField fx:id="typeField" promptText="type" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="170.0" />
            <TextField fx:id="noteField" promptText="note" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="220.0" />
            <TextField fx:id="nameStudentField" promptText="Nom de l'étudiant" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="270.0" />
            <Button onAction="#saveControle" style="-fx-background-color: #C0425F; -fx-text-fill: WHITE;" text="Enregistrer" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="300.0" />
         </children>
      </AnchorPane>
   </children>
</StackPane>
